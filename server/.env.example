# Copia questo file in ".env" (senza ".example") e inserisci i tuoi valori reali.
# Li trovi su supabase.com -> il tuo progetto -> Settings -> API.
# Il file ".env" non viene mai caricato su GitHub (è escluso nel .gitignore).

SUPABASE_URL=incolla_qui_project_url
SUPABASE_KEY=incolla_qui_service_role_key

# Per il vero login (email e password): Settings > API > "anon public".
# A differenza di SUPABASE_KEY qui sopra (service_role, segreta), questa
# chiave è fatta apposta per essere pubblica: il sito la manda al
# browser per farlo parlare con Supabase durante il login.
SUPABASE_ANON_KEY=incolla_qui_anon_public_key

PORT=3000

# Per mandare email vere (approvazioni, scarti, avvisi di scadenza, e
# la verifica dei certificati caricati): usa una casella Gmail. Metti
# qui l'indirizzo Gmail completo (è anche l'indirizzo che compare come
# mittente). Se lasci queste righe vuote o le togli, il sito continua a
# funzionare normalmente, semplicemente senza mandare email (lo scrive
# nel registro del server ogni volta che ne salta una).
GMAIL_USER=incolla_qui_il_tuo_indirizzo_gmail

# NON è la password normale dell'account Gmail: è una "Password per le
# app" di Google, un codice di 16 lettere che si genera da
# myaccount.google.com -> Sicurezza -> Verifica in due passaggi (deve
# essere attiva) -> Password per le app. Incollala qui senza spazi.
GMAIL_APP_PASSWORD=incolla_qui_la_password_per_le_app

# L'indirizzo a cui arrivano le email di verifica quando viene caricato
# un nuovo certificato medico (sia per un giocatore vero, sia per un
# nome che non corrisponde a nessuno). Può essere un indirizzo
# qualsiasi (con Gmail non ci sono restrizioni sul destinatario).
ADMIN_EMAIL=inserisci_qui_la_tua_email

# Codice segreto per il controllo automatico giornaliero delle scadenze
# QUANDO IL SITO È ONLINE (in locale non serve: qui sotto non fa
# nulla). Va impostato, con lo stesso valore, anche tra le variabili
# d'ambiente del progetto su Vercel (Project Settings > Environment
# Variables): serve a Vercel per dimostrare che è davvero lui, e non
# chiunque altro, a richiamare la rotta GET /api/cron/controlla-scadenze
# una volta al giorno. Un valore lungo e casuale va benissimo.
CRON_SECRET=incolla_qui_un_codice_segreto_lungo_e_casuale
